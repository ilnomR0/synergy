{
  "compilerOptions": {
    "baseUrl":".",
    "paths":{
        "@/*":["./src/ts/*"],
        "@syngyne/*":["./src/ts/syngyne/*"],
        "@ui/*":["./src/ts/ui/*"],
        "@objects/*":["./src/ts/objects/*"],
        "@level/*":["./src/ts/level/*"],
        "@assets/*":["./src/assets/*"]
    },
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "public/images", "public/levels"]
}

